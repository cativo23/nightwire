{
  "name": "@cativo23/nightwire",
  "version": "2.0.1",
  "description": "CLI installer for the Nightwire cyberpunk UI design system",
  "main": "dist/index.js",
  "bin": {
    "nightwire": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "nightwire.css",
    "tailwind.preset.js",
    "DESIGN.md",
    "skill/**/*"
  ],
  "scripts": {
    "build": "npm run build:tokens && npm run build:css && npm run build:cli",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:cli": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "parity": "node scripts/parity/compare.mjs",
    "prepublishOnly": "npm run build",
    "docs:dev": "cd apps/docs && npm run dev",
    "docs:build": "cd apps/docs && npm run build",
    "docs:preview": "cd apps/docs && npm run preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cativo23/nightwire.git"
  },
  "keywords": [
    "nightwire",
    "design-system",
    "cyberpunk",
    "cli",
    "dark-mode"
  ],
  "author": "cativo23",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cativo23/nightwire/issues"
  },
  "homepage": "https://github.com/cativo23/nightwire#readme",
  "dependencies": {
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "playwright-core": "^1.65.1",
    "typescript": "^5.7.0"
  }
}
